# Cadena de conexión a PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/pantera_al_acecho?schema=public"

# Secreto para firmar los JWT
JWT_SECRET="secreto"

# Tiempo de expiración del token 
JWT_EXPIRES_IN="8h"

# Puerto en el que escucha el servidor Express
PORT=4000

# Origen permitido para CORS (URL del cliente en desarrollo)
CLIENT_URL="http://localhost:5173"
