# Modo emulador (vite --mode emulador): Auth y Firestore locales de
# `firebase emulators:start`. Proyecto ficticio: el prefijo "demo-" hace
# que Firebase nunca toque un proyecto real. Sin secretos; se versiona.
VITE_USE_EMULATORS="true"
VITE_FIREBASE_API_KEY="demo-key"
VITE_FIREBASE_AUTH_DOMAIN="demo-pantera.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="demo-pantera"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
