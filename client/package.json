{
  "name": "pantera-al-acecho-client",
  "version": "1.0.0",
  "description": "Cliente SPA - Pantera al Acecho",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulador": "vite --mode emulador",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "emuladores": "firebase emulators:start --project demo-pantera --only auth,firestore",
    "test:firebase": "vitest run --config vitest.firebase.config.js --mode emulador",
    "test:firebase:ci": "firebase emulators:exec --project demo-pantera --only auth,firestore \"npm run test:firebase\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
